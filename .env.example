# Local-development defaults. Copy to .env only if you need to override values.
STEELMIND_DB_PATH=data/steelmind.db
STEELMIND_ENABLE_DEMO_SEED=false
STEELMIND_API_URL=http://127.0.0.1:8000
STEELMIND_DEFAULT_KERF_MM=3.0
STEELMIND_DEFAULT_EDGE_TRIM_MM=10.0

# Optional OpenAI-compatible text-extraction endpoint. Disabled by default.
# Keep secrets outside source control. Configure only after security/privacy review.
STEELMIND_LLM_ENABLED=false
STEELMIND_LLM_BASE_URL=https://api.openai.com/v1
STEELMIND_LLM_API_KEY=
STEELMIND_LLM_MODEL=
STEELMIND_LLM_TIMEOUT_SECONDS=12
